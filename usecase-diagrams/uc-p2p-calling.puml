@startuml uc-p2p-calling
' Sơ đồ Use Case: Concept B - Gọi video P2P giữa các người dùng
' Vấn đề 1: Trì hoãn khi xem trực tiếp

skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F9F9F9
  BorderColor #333333
  ArrowColor #333333
  MinimumWidth 150
}
skinparam actor {
  BackgroundColor #F9F9F9
  BorderColor #333333
}
skinparam rectangle {
  BackgroundColor #E8F4FD
  BorderColor #4A90D9
  BorderStyle dashed
}
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 10

left to right direction

actor "Người xem host" as host
actor "Người xem khách" as guest
actor "Máy chủ chính" as server

rectangle "Hệ thống phát trực tuyến P2P" as system {
  ' Nhóm use case của Host
  usecase "Bật cuộc gọi video" as UC1
  
  ' Nhóm use case của Guest
  usecase "Tham gia cuộc gọi video" as UC2
  usecase "Xem qua P2P" as UC3
  usecase "Quản lý âm thanh" as UC5
  
  ' Nhóm use case của Server
  usecase "Ưu tiên\nbăng thông" as UC4
}

' Liên kết actor-usecase với hướng rõ ràng
host -right-> UC1
guest -right-> UC2
guest -right-> UC3
guest -right-> UC5
server -left-> UC4

' Mối quan hệ include/extend
UC1 ..> UC3 : <<include>>
UC2 ..> UC3 : <<include>>
UC4 ..> UC1 : <<include>>

@enduml